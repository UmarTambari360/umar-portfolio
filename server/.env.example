# ---- Server -------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Where the browser loads the site from (used for CORS). Vite dev server port:
CLIENT_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the server. 0 in development;
# 1 in production behind Caddy (see docker-compose.prod.yml).
TRUST_PROXY=0

# ---- Data stores (match docker-compose.yml) -----------------------------
DATABASE_URL=postgresql://portfolio_admin:portfolio_secure_password@localhost:5433/portfolio_db
REDIS_URL=redis://:redis_secure_password@localhost:6380

# ---- Admin authentication -----------------------------------------------
# Secret used to sign login cookies. At least 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-32-random-characters
ADMIN_USERNAME=admin
# Generate with:  pnpm --filter @umar-portfolio/server hash-password
# Keep the single quotes around the value (bcrypt hashes contain "$").
ADMIN_PASSWORD_HASH=
# ---- Analytics ----------------------------------------------------------
# Secret mixed into the visitor-IP hash. At least 16 characters. Generate with:
#   openssl rand -hex 16
ANALYTICS_SALT=

