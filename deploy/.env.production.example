# Copy to .env.production in the repo root (it is git-ignored) and fill it in:
#   cp deploy/.env.production.example .env.production
#
# Use this file ONLY on the server. Never commit the real one.

# ---- Your domain --------------------------------------------------------
# Bare domain for Caddy (it will get the HTTPS certificate for it):
SITE_ADDRESS=example.com
# The same address with https:// (used by the API for CORS):
PUBLIC_URL=https://example.com

# ---- Database (generate each secret with: openssl rand -hex 24) ----------
# Hex values are URL-safe, which matters: they are placed inside a connection URL.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=portfolio
REDIS_PASSWORD=replace-me

# ---- Application secrets -------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=replace-me
# openssl rand -hex 16
ANALYTICS_SALT=replace-me

ADMIN_USERNAME=admin
# Generate on your own computer (never type the password into a shared terminal):
#   pnpm --filter @umar-portfolio/server hash-password
# KEEP THE SINGLE QUOTES: the hash contains "$" characters, which Docker Compose
# would otherwise treat as variables and silently corrupt the value.
ADMIN_PASSWORD_HASH='replace-me'

