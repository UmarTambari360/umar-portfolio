# Copy to client/.env.local to change local behaviour. Never put secrets in
# VITE_* variables: Vite embeds them in the browser bundle.
#
# (This file used to live in client/src/. Vite reads .env files from the
# client/ folder itself, so that is where the template belongs.)

# Production builds always send analytics. Set to "true" to also send them from
# `pnpm dev` (otherwise your dev traffic stays out of the analytics table).
VITE_ENABLE_ANALYTICS=

